DISABLE_SIGNUP=false
# Only after BGG approval AND reviewing current terms/attribution requirements:
BGG_API_TOKEN=
BGG_INTEGRATION_APPROVED=false
# Required when enabling BGG: official Powered by BGG logo URL, from your approved assets.
BGG_ATTRIBUTION_LOGO_URL=
