BETTER_AUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Required in production. Local development defaults to .data/postgres.
DATABASE_URL=
